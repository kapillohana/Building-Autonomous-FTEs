# 🔐 ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and fill in your actual secrets
# NEVER commit .env - it contains real credentials

# ============================================
# GMAIL CONFIGURATION
# ============================================

# Path to Google OAuth credentials.json
# Download from: https://console.cloud.google.com/apis/credentials
# File should be in: scripts/credentials.json (or elsewhere, adjust path)
GMAIL_CREDENTIALS_PATH=./scripts/credentials.json

# Path where the token.json will be stored (after first auth)
GMAIL_TOKEN_PATH=./scripts/token.json

# Gmail account to monitor (usually 'me' for authenticated user)
GMAIL_USER=me

# Check interval in seconds (how often to poll Gmail)
GMAIL_CHECK_INTERVAL=120

# ============================================
# VAULT CONFIGURATION
# ============================================

# Absolute path to your AI Employee Vault
VAULT_PATH=/absolute/path/to/AI_Employee_Vault

# Inbox folder to monitor for file drops
DROP_FOLDER=Drop

# File system watcher check interval (seconds)
FS_WATCH_INTERVAL=10

# ============================================
# LOGGING CONFIGURATION
# ============================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file location
LOG_FILE=./Logs/watcher.log

# ============================================
# OPTIONAL: FUTURE FEATURES
# ============================================

# WhatsApp (Silver tier)
# WHATSAPP_SESSION_PATH=/path/to/whatsapp/session

# LinkedIn (Silver tier)
# LINKEDIN_USERNAME=your_email@example.com
# LINKEDIN_PASSWORD=your_password

# Bank API (future)
# BANK_API_KEY=your_bank_api_key
# BANK_API_SECRET=your_bank_api_secret

# ============================================
# SECURITY NOTES
# ============================================
# - Never share .env file
# - Add .env to .gitignore (already done)
# - Rotate credentials monthly
# - Use strong, unique passwords
# - Enable 2FA where possible
# - For production: use OS Keychain or 1Password CLI
