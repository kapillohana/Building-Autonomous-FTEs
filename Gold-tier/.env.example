# Gold Tier - Environment Variables Template
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env to GitHub!

# ────────────────────────────────────────────────────────────────
# 🔐 ODOO ERP Configuration
# ────────────────────────────────────────────────────────────────
ODOO_URL=http://localhost:8069
ODOO_DB=ai_employee_company
ODOO_USERNAME=admin@aiemployee.com
ODOO_PASSWORD=your_odoo_password_here

# ────────────────────────────────────────────────────────────────
# 📧 GMAIL Configuration
# ────────────────────────────────────────────────────────────────
# Get credentials from: https://console.cloud.google.com/apis/credentials
GMAIL_CREDENTIALS_PATH=scripts/credentials.json
GMAIL_TOKEN_PATH=scripts/token.json

# ────────────────────────────────────────────────────────────────
# 📘 FACEBOOK Configuration
# ────────────────────────────────────────────────────────────────
FACEBOOK_EMAIL=your_facebook_email@example.com
FACEBOOK_PASSWORD=your_facebook_password_here

# ────────────────────────────────────────────────────────────────
# 📷 INSTAGRAM Configuration
# ────────────────────────────────────────────────────────────────
INSTAGRAM_EMAIL=your_instagram_email@example.com
INSTAGRAM_PASSWORD=your_instagram_password_here

# ────────────────────────────────────────────────────────────────
# 🐦 TWITTER/X Configuration
# ────────────────────────────────────────────────────────────────
TWITTER_EMAIL=your_twitter_email@example.com
TWITTER_USERNAME=your_twitter_handle
TWITTER_PASSWORD=your_twitter_password_here

# ────────────────────────────────────────────────────────────────
# 💬 WHATSAPP Configuration
# ────────────────────────────────────────────────────────────────
# WhatsApp Web session credentials (auto-generated)
# WHATSAPP_PHONE=+1234567890

# ────────────────────────────────────────────────────────────────
# 💼 LINKEDIN Configuration
# ────────────────────────────────────────────────────────────────
# LinkedIn session credentials (auto-generated via browser)
# LINKEDIN_EMAIL=your_linkedin_email@example.com
# LINKEDIN_PASSWORD=your_linkedin_password_here

# ────────────────────────────────────────────────────────────────
# 🔧 Optional: API Keys for Extended Features
# ────────────────────────────────────────────────────────────────
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ────────────────────────────────────────────────────────────────
# ⚙️ Application Settings
# ────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
# CHECK_INTERVAL=300
# ERROR_RECOVERY_MAX_RETRIES=3
