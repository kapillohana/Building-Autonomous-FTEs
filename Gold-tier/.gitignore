# Gold Tier - Git Ignore File
# Protects sensitive credentials and session data

# ────────────────────────────────────────────────────────────────
# 🔐 SECURITY: Credentials & Environment
# ────────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.env
credentials.json
token.json
service_account.json
*.pem
*.key
secret*.json

# ────────────────────────────────────────────────────────────────
# 👤 Session Files (Contain Auth Tokens)
# ────────────────────────────────────────────────────────────────
*_session.json
linkedin_session.json
whatsapp_session.json
facebook_session.json
instagram_session.json
twitter_session.json
*.session
*.cookies

# ────────────────────────────────────────────────────────────────
# 📝 Processed/Cache Files
# ────────────────────────────────────────────────────────────────
processed_*.json
*.pyc
__pycache__/
*.py[cod]
*$py.class
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ────────────────────────────────────────────────────────────────
# 🗂️ Logs & Temporary Files
# ────────────────────────────────────────────────────────────────
*.log
logs/*.log
*.tmp
*.bak
*.swp
*~
.DS_Store
Thumbs.db

# ────────────────────────────────────────────────────────────────
# 🧪 Test Files (Optional - exclude test data)
# ────────────────────────────────────────────────────────────────
# test_*.py
# *_test.py
# tests/coverage/

# ────────────────────────────────────────────────────────────────
# 📦 IDE & Editor
# ────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.sublime-project
*.sublime-workspace
.settings/
.project
.classpath

# ────────────────────────────────────────────────────────────────
# 🐍 Python Virtual Environment
# ────────────────────────────────────────────────────────────────
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/

# ────────────────────────────────────────────────────────────────
# 📊 Odoo Docker Data (Generated)
# ────────────────────────────────────────────────────────────────
odoo/data/db/
odoo/config/
odoo/addons/

# ────────────────────────────────────────────────────────────────
# ✅ What IS Committed to GitHub
# ────────────────────────────────────────────────────────────────
# ✓ All Python scripts (*.py)
# ✓ All skill documentation (Skills/*.md)
# ✓ Dashboard.md, Company_Handbook.md, README.md
# ✓ docker-compose.yml (not the data)
# ✓ .env.example (template for others)
# ✓ All watcher scripts
# ✓ All MCP server code
